# Copy to .env and fill in. Never commit .env.
TYPESAFE_API_KEY=
# Only for the future `api` backend (not implemented yet); leave blank
ANTHROPIC_API_KEY=
# cli (default, uses `claude -p`); `api` is reserved for the future API backend
TRACEROOT_CLAUDE_BACKEND=cli
TRACEROOT_CLAUDE_MODEL=claude-haiku-5-5
# Path to the claude executable if it is not on PATH
TRACEROOT_CLAUDE_BIN=
GATE_THRESHOLD=0.8
